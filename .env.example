PORT=3000
CORS_ORIGIN=http://localhost:5173
# Usuário próprio do back-end (db/005_papel_aplicacao.sql), nunca o "postgres".
DATABASE_URL=postgres://kanban_app:senha@localhost:5432/kanban
JWT_SECRET=
GOOGLE_CLIENT_ID=
SESSAO_HORAS=8
LOGIN_BLOQUEIO_MINUTOS=5
# Dias de validade do código de convite do cadastro com senha.
CONVITE_VALIDADE_DIAS=7
# Só defina atrás de um proxy (o docker-compose já usa 1 para o Nginx).
# TRUST_PROXY=1
